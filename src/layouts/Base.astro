---
const {
  title,
  description,
  type = 'website',
  bodyClass = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/essays', label: 'Writing' },
  { href: '/about', label: 'About' },
];
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f3f0e8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Hasan Shahriar" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="Hasan Shahriar" href="/rss.xml" />
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="monogram" href="/" aria-label="Hasan Shahriar, home">
      <span>H</span><span>S</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {nav.map(item => (
        <a class:list={{ active: currentPath.startsWith(item.href) }} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <a class="header-cta" href="mailto:hasan@hasanshahriar.com">
      <i aria-hidden="true"></i> Available for the right role
    </a>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="site-footer__lead">
      <p class="eyebrow">Start a conversation</p>
      <a href="mailto:hasan@hasanshahriar.com">hasan@hasanshahriar.com</a>
    </div>
    <div class="site-footer__grid">
      <div>
        <strong>Hasan Shahriar</strong>
        <p>Product builder and founder<br/>in Helsinki, by way of Dhaka.</p>
      </div>
      <div>
        <strong>Explore</strong>
        <a href="/work">Work</a>
        <a href="/experience">Experience</a>
        <a href="/essays">Writing</a>
        <a href="/journey">The long way here</a>
      </div>
      <div>
        <strong>Elsewhere</strong>
        <a href="https://www.linkedin.com/in/hasan-shahriar-rhiday/">LinkedIn</a>
        <a href="https://github.com/rhiday">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="site-footer__note">
        <span>Helsinki · {new Date().getFullYear()}</span>
        <span>Built with Astro. Sent, not saved.</span>
      </div>
    </div>
  </footer>
</body>
</html>
