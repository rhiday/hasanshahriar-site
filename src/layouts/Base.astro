---
const {
  title,
  description,
  type = 'website',
  bodyClass = '',
  pageSchemaType = 'WebPage',
  structuredData = [],
  publishedTime,
} = Astro.props;
const normalizedPath = Astro.url.pathname === '/'
  ? '/'
  : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(normalizedPath, Astro.site).href;
const currentPath = Astro.url.pathname;
const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const webpageId = `${canonical}#webpage`;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLabels = {
  work: 'Work',
  experience: 'Experience',
  essays: 'Writing',
  about: 'About',
  journey: 'Journey',
  cv: 'CV',
};
const breadcrumbItems = pathSegments.map((segment, index) => ({
  '@type': 'ListItem',
  position: index + 2,
  name: index === pathSegments.length - 1
    ? title.split(' — ')[0]
    : breadcrumbLabels[segment] || segment.replaceAll('-', ' '),
  item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}/`, Astro.site).href,
}));
const graph = [
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Hasan Shahriar',
    url: siteUrl,
    email: 'mailto:hasan@hasanshahriar.com',
    jobTitle: 'Product builder and founder',
    homeLocation: {
      '@type': 'Place',
      name: 'Helsinki, Finland',
    },
    knowsAbout: [
      'Product strategy',
      'Artificial intelligence products',
      'Enterprise software',
      'Full-stack product delivery',
      'Company building',
    ],
    sameAs: [
      'https://www.linkedin.com/in/hasan-shahriar-rhiday/',
      'https://github.com/rhiday',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: siteUrl,
    name: 'Hasan Shahriar',
    description: 'Work, experience and essays by Helsinki-based product builder and founder Hasan Shahriar.',
    publisher: { '@id': personId },
    inLanguage: 'en',
  },
  {
    '@type': pageSchemaType,
    '@id': webpageId,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
    mainEntity: pageSchemaType === 'ProfilePage' ? { '@id': personId } : undefined,
    inLanguage: 'en',
  },
  ...(pathSegments.length > 0 ? [{
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      ...breadcrumbItems,
    ],
  }] : []),
  ...structuredData,
];
const ld = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/essays', label: 'Writing' },
  { href: '/about', label: 'About' },
];
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f3f0e8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Hasan Shahriar" />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="author" href="/about" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Hasan Shahriar" />
  <meta property="og:locale" content="en_GB" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="alternate" type="application/rss+xml" title="Hasan Shahriar" href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="monogram" href="/" aria-label="Hasan Shahriar, home">
      <span>H</span><span>S</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {nav.map(item => (
        <a class:list={{ active: currentPath.startsWith(item.href) }} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <a class="header-cta" href="mailto:hasan@hasanshahriar.com">
      <i aria-hidden="true"></i> Available for the right role
    </a>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="site-footer__lead">
      <p class="eyebrow">Start a conversation</p>
      <a href="mailto:hasan@hasanshahriar.com">hasan@hasanshahriar.com</a>
    </div>
    <div class="site-footer__grid">
      <div>
        <strong>Hasan Shahriar</strong>
        <p>Product builder and founder<br/>in Helsinki, by way of Dhaka.</p>
      </div>
      <div>
        <strong>Explore</strong>
        <a href="/work">Work</a>
        <a href="/experience">Experience</a>
        <a href="/essays">Writing</a>
        <a href="/journey">The long way here</a>
      </div>
      <div>
        <strong>Elsewhere</strong>
        <a href="https://www.linkedin.com/in/hasan-shahriar-rhiday/">LinkedIn</a>
        <a href="https://github.com/rhiday">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="site-footer__note">
        <span>Helsinki · {new Date().getFullYear()}</span>
        <span>Built with Astro. Sent, not saved.</span>
      </div>
    </div>
  </footer>
</body>
</html>
