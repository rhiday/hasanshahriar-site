---
const { eyebrow, title, copy, link, linkLabel } = Astro.props;
import Arrow from './Arrow.astro';
---
<div class="section-head">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  <div class="section-head__aside">
    {copy && <p>{copy}</p>}
    {link && (
      <a class="text-link" href={link}>
        {linkLabel}<Arrow />
      </a>
    )}
  </div>
</div>
