---
import CaseVisual from './CaseVisual.astro';
import Arrow from './Arrow.astro';
const { entry, index } = Astro.props;
const data = entry.data;
---
<article class={`case-card case-card--${data.accent}`}>
  <a class="case-card__visual" href={`/work/${entry.slug}`} aria-label={`Read ${data.title} case study`}>
    <CaseVisual slug={entry.slug} title={data.title} client={data.client} compact />
  </a>
  <div class="case-card__body">
    <div class="case-card__index">{String(index + 1).padStart(2, '0')}</div>
    <div>
      <p class="eyebrow">{data.client} · {data.year}</p>
      <h3><a href={`/work/${entry.slug}`}>{data.title}</a></h3>
      <p>{data.summary}</p>
      <a class="text-link" href={`/work/${entry.slug}`}>Read the case <Arrow /></a>
    </div>
  </div>
</article>
