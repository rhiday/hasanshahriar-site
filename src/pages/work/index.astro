---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCollection } from 'astro:content';
const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Work — Hasan Shahriar"
  description="Selected product, AI, enterprise and client work by Hasan Shahriar."
  pageSchemaType="CollectionPage"
>
  <header class="page-hero shell">
    <p class="eyebrow">Selected work · 2017–now</p>
    <h1>Systems I helped move from unclear to real.</h1>
    <p class="page-hero__lede">A mix of products, platforms and client relationships. The common thread is ownership: understanding the problem around the brief, then staying close enough to ship.</p>
  </header>
  <section class="section shell section--page">
    <div class="case-list">
      {cases.map((entry, index) => <CaseCard entry={entry} index={index} headingLevel={2} />)}
    </div>
  </section>
</Base>
