---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Arrow from '../components/Arrow.astro';
import { getCollection } from 'astro:content';
import { experience, trustedBy } from '../data/experience';

const cases = (await getCollection('cases', entry => entry.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const essays = await getCollection('essays', entry => !entry.data.draft);
const featuredEssays = ['sent-not-saved', 'we-used-to-just-move', 'foreigners']
  .map(slug => essays.find(entry => entry.slug === slug))
  .filter(Boolean);
---
<Base
  title="Hasan Shahriar — Product builder and founder"
  description="Helsinki-based product builder and founder. Enterprise systems, AI products, detailed case studies and essays from the edge."
  bodyClass="home"
>
  <section class="home-hero shell">
    <div class="home-hero__status">
      <span class="status-dot"></span>
      Helsinki · Open to senior product and AI roles
    </div>
    <h1>
      I build products for the part where the brief
      <em>stops being clear.</em>
    </h1>
    <div class="home-hero__bottom">
      <p>
        I’m Hasan, a product builder and founder in Helsinki. Eight-plus years moving
        between enterprise systems, zero-to-one products and the people who
        have to make them work.
      </p>
      <div class="hero-actions">
        <a class="button button--dark" href="/work">See selected work <Arrow /></a>
        <a class="button button--line" href="mailto:hasan@hasanshahriar.com">Talk to me</a>
      </div>
    </div>
    <div class="hero-note">
      <span>Dhaka → Helsinki</span>
      <span>Product · AI · Full-stack delivery</span>
      <span>Proof of work, with a pulse.</span>
    </div>
  </section>

  <section class="trust-rail" aria-label="Organisations represented in Hasan's work and pilots">
    <div class="shell trust-rail__inner">
      <span class="eyebrow">Work, pilots &amp; teams include</span>
      <div class="trust-rail__names">
        {trustedBy.map(name => <span>{name}</span>)}
      </div>
    </div>
  </section>

  <section class="section shell">
    <SectionHead
      eyebrow="Selected work"
      title="The receipts"
      copy="Not a gallery of polished endings. These are the systems, constraints and decisions behind the work."
      link="/work"
      linkLabel="See all work"
    />
    <div class="case-list">
      {cases.map((entry, index) => <CaseCard entry={entry} index={index} />)}
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell">
      <SectionHead
        eyebrow="Experience"
        title="Range is useful when it adds up."
        copy="Enterprise taught me coordination. Client work taught me ownership. Startups taught me that the clean plan rarely survives Tuesday."
        link="/experience"
        linkLabel="Full experience"
      />
      <div class="experience-list">
        {experience.slice(0, 4).map(item => (
          <a class="experience-row" href={item.href}>
            <span class="experience-row__period">{item.period}</span>
            <span class="experience-row__company">{item.company}</span>
            <span class="experience-row__role">{item.role}</span>
            <span class="experience-row__arrow"><Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell writing-section">
    <SectionHead
      eyebrow="Writing"
      title="The work tells you what I did. The writing tells you how I think."
      copy="Essays on shipping, instinct, AI and the double-vision that comes from building between cultures."
      link="/essays"
      linkLabel="Read all essays"
    />
    <div class="featured-essays">
      {featuredEssays.map((entry, index) => (
        <a class="essay-tile" href={`/essays/${entry.slug}`}>
          <span class="essay-tile__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="essay-tile__title">{entry.data.title}</span>
          <span class="essay-tile__description">{entry.data.description}</span>
          <span class="essay-tile__arrow"><Arrow /></span>
        </a>
      ))}
    </div>
    <blockquote class="home-quote">
      <p>“The work is not the thing you make. The work is the sending.”</p>
      <cite>From <a href="/essays/sent-not-saved">Sent, Not Saved</a></cite>
    </blockquote>
  </section>

  <section class="section section--story">
    <div class="shell story-grid">
      <div>
        <p class="eyebrow">The long way here</p>
        <h2>Two operating systems. One builder.</h2>
      </div>
      <div class="story-copy">
        <p>
          I arrived in Finland from Bangladesh in 2016. At immigration, the
          locals walked straight through and the foreigners queued—the exact
          inverse of Dhaka airport. Nothing about me had changed in eleven
          hours. Everything about my position had.
        </p>
        <p>
          That small reversal became a useful way of seeing: there is always
          another system underneath the obvious one.
        </p>
        <a class="text-link" href="/journey">Read the full journey <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="contact-band shell">
    <p class="eyebrow">What I’m looking for</p>
    <h2>A hard product problem, a good team, and enough trust to do the work properly.</h2>
    <div>
      <p>Open to senior product, AI and innovation roles in Helsinki or remote across Europe. I also take on selected consulting work through Makeshift.</p>
      <a class="button button--acid" href="mailto:hasan@hasanshahriar.com">Start a conversation <Arrow /></a>
    </div>
  </section>
</Base>
