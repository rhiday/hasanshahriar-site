---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { experience } from '../data/experience';
---
<Base title="Experience | Hasan Shahriar" description="Hasan Shahriar's experience across product, AI, enterprise consulting and company building.">
  <header class="page-hero shell">
    <p class="eyebrow">Experience</p>
    <h1>I’ve spent eight years learning where product work actually lives.</h1>
    <p class="page-hero__lede">Usually somewhere between the clean strategy slide and the person who has to use the thing on a busy Tuesday.</p>
    <div class="hero-actions">
      <a class="button button--dark" href="mailto:hasan@hasanshahriar.com">Discuss a role <Arrow /></a>
      <a class="button button--line" href="https://www.linkedin.com/in/hasan-shahriar-rhiday/">LinkedIn</a>
    </div>
  </header>

  <section class="section shell section--page">
    <div class="experience-detail">
      {experience.map((item, index) => (
        <article class="experience-detail__item" id={item.company.toLowerCase()}>
          <div class="experience-detail__marker">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <i></i>
          </div>
          <div class="experience-detail__when">{item.period}</div>
          <div class="experience-detail__content">
            <p class="eyebrow">{item.company}</p>
            <h2>{item.role}</h2>
            <p>{item.summary}</p>
            <strong>{item.proof}</strong>
            {item.href.startsWith('/work/') && (
              <a class="text-link" href={item.href}>Read the case <Arrow /></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell capability-grid">
      <div>
        <p class="eyebrow">What the titles flatten</p>
        <h2>I work across the seams.</h2>
      </div>
      <div class="capability-list">
        <div><span>01</span><h3>Product judgement</h3><p>Finding the actual decision inside an overgrown problem.</p></div>
        <div><span>02</span><h3>Hands-on delivery</h3><p>Prototyping, building and working closely enough with code to know what is real.</p></div>
        <div><span>03</span><h3>Commercial context</h3><p>Understanding that products live inside sales, operations, incentives and trust.</p></div>
        <div><span>04</span><h3>Founder ownership</h3><p>Staying with the result after the interesting part is finished.</p></div>
      </div>
    </div>
  </section>
</Base>
